# =====================================================
# apps/notification-service/Dockerfile
# =====================================================
FROM node:20-alpine

WORKDIR /usr/src/app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY nest-cli.json ./

# Install dependencies
RUN npm ci

# Copy notification service source
COPY apps/notification-service ./apps/notification-service

# Copy notification service prisma
COPY apps/notification-service/prisma ./apps/notification-service/prisma

# Generate Prisma client
RUN npx prisma generate --schema=apps/notification-service/prisma/schema.prisma

# Build the application
RUN npm run build notification-service

# Expose port (not needed for microservice, but good for debugging)
EXPOSE 3006

# Start the application
CMD ["node", "dist/apps/notification-service/main"]
