{
  "name": "event-ticketing-platform",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    
    "start:api-gateway": "nest start api-gateway --watch",
    "start:user-service": "nest start user-service --watch",
    "start:event-service": "nest start event-service --watch",
    "start:ticket-service": "nest start ticket-service --watch",
    "start:order-service": "nest start order-service --watch",
    "start:payment-service": "nest start payment-service --watch",
    "start:notification-service": "nest start notification-service --watch",
    
    "build:api-gateway": "nest build api-gateway",
    "build:user-service": "nest build user-service",
    "build:event-service": "nest build event-service",
    "build:ticket-service": "nest build ticket-service",
    "build:order-service": "nest build order-service",
    "build:payment-service": "nest build payment-service",
    "build:notification-service": "nest build notification-service",
    "build:all": "npm run build:api-gateway && npm run build:user-service && npm run build:event-service && npm run build:ticket-service && npm run build:order-service && npm run build:payment-service && npm run build:notification-service",
    
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    
    "test:api-gateway": "jest --config apps/api-gateway/jest.json",
    "test:user-service": "jest --config apps/user-service/jest.json",
    "test:event-service": "jest --config apps/event-service/jest.json",
    "test:ticket-service": "jest --config apps/ticket-service/jest.json",
    "test:order-service": "jest --config apps/order-service/jest.json",
    "test:payment-service": "jest --config apps/payment-service/jest.json",
    "test:notification-service": "jest --config apps/notification-service/jest.json",
    "test:all": "npm run test:api-gateway && npm run test:user-service && npm run test:event-service && npm run test:ticket-service && npm run test:order-service && npm run test:payment-service && npm run test:notification-service",
    

    "prisma:generate": "npm run prisma:generate:user && npm run prisma:generate:event && npm run prisma:generate:ticket && npm run prisma:generate:order && npm run prisma:generate:payment && npm run prisma:generate:notification",
    "prisma:generate:user": "cd apps/user-service && npx prisma generate",
    "prisma:generate:event": "cd apps/event-service && npx prisma generate", 
    "prisma:generate:ticket": "cd apps/ticket-service && npx prisma generate",
    "prisma:generate:order": "cd apps/order-service && npx prisma generate",
    "prisma:generate:payment": "cd apps/payment-service && npx prisma generate",
    "prisma:generate:notification": "cd apps/notification-service && npx prisma generate",
    
    "migrate:dev": "npm run migrate:user:dev && npm run migrate:event:dev && npm run migrate:ticket:dev && npm run migrate:order:dev && npm run migrate:payment:dev && npm run migrate:notification:dev",
    "migrate:user:dev": "cd apps/user-service && npx prisma migrate dev",
    "migrate:event:dev": "cd apps/event-service && npx prisma migrate dev",
    "migrate:ticket:dev": "cd apps/ticket-service && npx prisma migrate dev",
    "migrate:order:dev": "cd apps/order-service && npx prisma migrate dev",
    "migrate:payment:dev": "cd apps/payment-service && npx prisma migrate dev",
    "migrate:notification:dev": "cd apps/notification-service && npx prisma migrate dev",
    
    "staging:start": "docker-compose -f deployment/docker/docker-compose.staging.yml up -d",
    "staging:stop": "docker-compose -f deployment/docker/docker-compose.staging.yml down",
    "staging:logs": "docker-compose -f deployment/docker/docker-compose.staging.yml logs -f",
    "staging:health": "curl -f http://localhost:8081/health",
    
    "test:env:start": "docker-compose -f deployment/docker/docker-compose.test.yml up -d",
    "test:env:stop": "docker-compose -f deployment/docker/docker-compose.test.yml down",
    "test:env:health": "curl -f http://localhost:5100/health",
    
    "ports:check": "./scripts/check-ports-safe.sh",
    "ports:monitor": "./scripts/port-monitor.sh",
    "ports:cleanup": "./scripts/cleanup-ports.sh",
    
    "load:test:staging": "node scripts/load-test.js --requests=100 --concurrent=10 --target=http://localhost:8081",
    "load:test:ci": "node scripts/load-test.js --requests=50 --concurrent=5 --target=http://localhost:5100",

    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "docker:clean": "docker compose down -v && docker system prune -f",
    
    "docker:infrastructure": "docker compose up postgres-user postgres-event postgres-ticket postgres-order postgres-payment rabbitmq redis -d",
    "docker:services": "docker compose up api-gateway-1 api-gateway-2 user-service-1 user-service-2 event-service-1 event-service-2 ticket-service-1 ticket-service-2 order-service-1 order-service-2 payment-service-1 payment-service-2 notification-service-1 notification-service-2 -d",
    "docker:monitoring": "docker compose up prometheus grafana alertmanager -d",
    "docker:loadbalancer": "docker compose up nginx -d",
    
    "docker:full": "npm run docker:infrastructure && sleep 10 && npm run docker:services && sleep 5 && npm run docker:monitoring && npm run docker:loadbalancer",
    "docker:dev": "docker compose up postgres-user rabbitmq redis prometheus grafana -d",
    
    "logs:nginx": "docker compose logs -f nginx",
    "logs:api-gateway": "docker compose logs -f api-gateway-1 api-gateway-2",
    "logs:user-service": "docker compose logs -f user-service-1 user-service-2",
    "logs:event-service": "docker compose logs -f event-service-1 event-service-2",
    "logs:ticket-service": "docker compose logs -f ticket-service-1 ticket-service-2",
    "logs:order-service": "docker compose logs -f order-service-1 order-service-2",
    "logs:payment-service": "docker compose logs -f payment-service-1 payment-service-2",
    "logs:notification-service": "docker compose logs -f notification-service-1 notification-service-2",
    "logs:monitoring": "docker compose logs -f prometheus grafana alertmanager",
    "logs:infrastructure": "docker compose logs -f postgres-user postgres-event postgres-ticket postgres-order postgres-payment rabbitmq redis",
    
    "health:check": "curl -f http://localhost/health || exit 1",
    "health:nginx": "curl -f http://localhost:8080/health || exit 1",
    "health:services": "node scripts/health-check.js",
    
    "loadtest:light": "node scripts/load-test.js --requests=100 --concurrent=5",
    "loadtest:medium": "node scripts/load-test.js --requests=1000 --concurrent=20",
    "loadtest:heavy": "node scripts/load-test.js --requests=5000 --concurrent=50",
    
    "scale:up": "docker compose up --scale api-gateway-1=2 --scale api-gateway-2=2 --scale user-service-1=2 --scale user-service-2=2 -d",
    "scale:down": "docker compose up --scale api-gateway-1=1 --scale api-gateway-2=1 --scale user-service-1=1 --scale user-service-2=1 -d",
    
    "deploy:staging": "docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d",
    "deploy:production": "docker compose -f docker-compose.yml -f docker-compose.production.yml up -d",
    
    "backup:db": "node scripts/backup-databases.js",
    "restore:db": "node scripts/restore-databases.js",
    
    "ci:build": "npm run build:all",
    "ci:test": "npm run test:all",
    "ci:lint": "npm run lint",
    "ci:security": "npm audit --audit-level=high",
    "ci:docker": "npm run docker:build && npm run docker:up && sleep 30 && npm run health:check"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.10.1",
    "@types/handlebars": "^4.1.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.0",
    "express-prometheus-middleware": "^1.2.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^6.10.1",
    "prom-client": "^13.2.0",
    "redis": "^5.5.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^18.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.33",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  }
}